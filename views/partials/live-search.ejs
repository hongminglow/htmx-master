<div class="section-heading">
  <div>
    <p class="eyebrow">keyup changed delay:300ms</p>
    <h2>Live search with debounced requests</h2>
  </div>
  <p>Search terms are sent as query parameters and the results list returns as HTML.</p>
</div>

<div class="search-layout">
  <label class="field search-field">
    <span>Search htmx features</span>
    <input
      type="search"
      name="q"
      placeholder="Try swap, trigger, delete, header"
      hx-get="/api/search"
      hx-trigger="keyup changed delay:300ms"
      hx-target="#search-results"
      hx-indicator="#search-spinner"
    >
  </label>
  <span id="search-spinner" class="spinner"></span>
  <div id="search-results" class="search-results">
    <%- include("search-results", { query: "", results: [] }) %>
  </div>
</div>

<details class="code-panel">
  <summary>Debounced input</summary>
  <pre><code>&lt;input name="q"
       hx-get="/api/search"
       hx-trigger="keyup changed delay:300ms"
       hx-target="#search-results"&gt;</code></pre>
</details>
