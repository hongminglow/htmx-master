<div class="section-heading">
  <div>
    <p class="eyebrow">Notifications</p>
    <h2>Workspace notifications</h2>
  </div>
  <p>Trigger a workspace notification and watch it appear here.</p>
</div>

<div class="toast-demo">
  <div class="button-row">
    <button class="button button-primary" type="button" hx-post="/api/toast/trigger?kind=success" hx-swap="none">Send success notification</button>
    <button class="button button-ghost" type="button" hx-post="/api/toast/trigger?kind=warning" hx-swap="none">Send warning notification</button>
  </div>
  <div
    id="toast-list"
    class="toast-list"
    hx-get="/api/toast/latest"
    hx-trigger="showToast from:body"
    hx-swap="afterbegin"
    aria-live="polite"
  ></div>
</div>
