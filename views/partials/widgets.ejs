<div class="section-heading">
  <div>
    <p class="eyebrow">hx-trigger="load"</p>
    <h2>Lazy-loaded dashboard widgets</h2>
  </div>
  <p>Each metric starts as a skeleton and asks the server for its fragment when it enters the DOM.</p>
</div>

<div class="widget-grid">
  <% widgetIds.forEach((id, index) => { %>
    <% const trigger = index === 0 ? "load" : "load delay:" + ((index + 1) * 140) + "ms"; %>
    <article
      class="metric-tile"
      id="widget-<%= id %>"
      hx-get="/api/widget/<%= id %>"
      hx-trigger="<%= trigger %>"
      hx-swap="innerHTML"
      hx-indicator="#widget-loader-<%= id %>"
    >
      <div class="skeleton-line wide"></div>
      <div class="skeleton-number"></div>
      <div class="skeleton-line"></div>
      <span id="widget-loader-<%= id %>" class="spinner"></span>
    </article>
  <% }) %>
</div>

<details class="code-panel">
  <summary>Lazy-load markup</summary>
  <pre><code>&lt;article hx-get="/api/widget/requests"
         hx-trigger="load"
         hx-swap="innerHTML"
         hx-indicator="#widget-loader"&gt;</code></pre>
</details>
