<div id="tab-demo">
  <div class="section-heading">
    <div>
      <p class="eyebrow">Views</p>
      <h2>Workspace views</h2>
    </div>
    <p>Switch between focused views without leaving the dashboard.</p>
  </div>

  <% const tabs = [
    { id: "overview", label: "Overview" },
    { id: "lifecycle", label: "Activity" },
    { id: "forms", label: "Forms" },
    { id: "headers", label: "Events" }
  ]; %>

  <div class="tab-list" role="tablist" aria-label="Dashboard views">
    <% tabs.forEach((tab) => { %>
      <button
        class="tab-button <%= activeTab === tab.id ? "is-active" : "" %>"
        type="button"
        role="tab"
        aria-selected="<%= activeTab === tab.id ? "true" : "false" %>"
        hx-get="/api/tabs/<%= tab.id %>"
        hx-target="#tab-demo"
        hx-swap="outerHTML transition:true"
        hx-push-url="/dashboard?tab=<%= tab.id %>"
      >
        <%= tab.label %>
      </button>
    <% }) %>
  </div>

  <div id="tab-content" class="tab-content">
    <span class="mono-label"><%= tabContent.eyebrow %></span>
    <h3><%= tabContent.title %></h3>
    <p><%= tabContent.body %></p>
    <ul class="fact-list">
      <% tabContent.facts.forEach((fact) => { %>
        <li><%= fact %></li>
      <% }) %>
    </ul>
  </div>
</div>
