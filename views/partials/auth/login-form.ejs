<div class="form-header">
  <p class="eyebrow">Demo access</p>
  <h2>Sign in</h2>
</div>

<form class="stacked-form" hx-post="/auth/login" hx-target="#login-result" hx-swap="innerHTML" hx-indicator="#login-spinner">
  <label class="field">
    <span>Username</span>
    <input
      name="username"
      autocomplete="username"
      placeholder="admin"
      required
      hx-get="/auth/check-username"
      hx-trigger="keyup changed delay:500ms"
      hx-target="#username-status"
    >
  </label>
  <div id="username-status" class="field-feedback" aria-live="polite"></div>

  <label class="field">
    <span>Password</span>
    <input
      name="password"
      type="password"
      autocomplete="current-password"
      placeholder="admin123"
      required
      hx-post="/auth/password-strength"
      hx-trigger="keyup changed delay:300ms"
      hx-target="#password-strength"
    >
  </label>
  <div id="password-strength" class="strength strength-empty">
    <span></span>
    <strong>Password strength</strong>
  </div>

  <label class="check-row">
    <input
      type="checkbox"
      name="remember"
      value="true"
      hx-get="/auth/remember-me-info"
      hx-target="#remember-info"
      hx-swap="innerHTML transition:true"
    >
    <span>Remember this browser</span>
  </label>
  <div id="remember-info" class="field-feedback muted" aria-live="polite"></div>

  <div class="form-actions">
    <button class="button button-primary" type="submit">Sign in</button>
    <span id="login-spinner" class="spinner" aria-label="Signing in"></span>
  </div>
  <div id="login-result" aria-live="polite"></div>
</form>

<button
  class="button button-ghost full-width auth-secondary-action"
  type="button"
  hx-get="/auth/register/step/1"
  hx-target="#auth-form-container"
  hx-swap="innerHTML transition:true"
>
  Create demo account
</button>
