<div class="section-heading">
  <div>
    <p class="eyebrow">Work items</p>
    <h2>CRUD table with inline editing</h2>
  </div>
  <p>Create, edit, and remove rows from the workspace.</p>
</div>

<div class="crud-toolbar">
  <form class="inline-create" hx-post="/api/items" hx-target="#items-body" hx-swap="beforeend">
    <label class="field">
      <span>Item</span>
      <input name="name" placeholder="New workspace item" required>
    </label>
    <label class="field">
      <span>Owner</span>
      <input name="owner" placeholder="Owner" required>
    </label>
    <label class="field">
      <span>Status</span>
      <select name="status">
        <option>Draft</option>
        <option>Review</option>
        <option>Active</option>
      </select>
    </label>
    <button class="button button-primary" type="submit">Add row</button>
  </form>
  <div class="count-chip">
    <span id="item-count"><%= items.length %></span>
    <span>items</span>
  </div>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Owner</th>
        <th>Status</th>
        <th>Updated</th>
        <th class="table-actions">Actions</th>
      </tr>
    </thead>
    <tbody id="items-body">
      <% items.forEach((item) => { %>
        <%- include("item-row", { item }) %>
      <% }) %>
    </tbody>
  </table>
</div>
