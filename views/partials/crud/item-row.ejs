<tr id="item-<%= item.id %>" class="crud-row">
  <td><strong><%= item.name %></strong></td>
  <td><%= item.owner %></td>
  <td>
    <span class="badge badge-<%= statusClass(item.status) %>">
      <span class="badge-dot"></span>
      <%= item.status %>
    </span>
  </td>
  <td><%= item.updated %></td>
  <td class="table-actions">
    <button
      class="icon-button"
      type="button"
      title="Edit row"
      aria-label="Edit row"
      hx-get="/api/items/<%= item.id %>/edit"
      hx-target="closest tr"
      hx-swap="outerHTML transition:true"
    >
      <%- icon("pencil", { size: 14 }) %>
      <span>Edit</span>
    </button>
    <button
      class="icon-button danger"
      type="button"
      title="Delete row"
      aria-label="Delete row"
      hx-delete="/api/items/<%= item.id %>"
      hx-target="closest tr"
      hx-swap="outerHTML swap:500ms"
      hx-confirm="Delete '<%= item.name %>'? This row will be removed from the workspace."
      data-confirm-ok="Delete row"
      data-confirm-cancel="Keep it"
      data-confirm-tone="danger"
    >
      <%- icon("trash", { size: 14 }) %>
      <span>Delete</span>
    </button>
  </td>
</tr>
