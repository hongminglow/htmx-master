<div class="section-heading">
  <div>
    <p class="eyebrow">POST, PUT, DELETE, OOB</p>
    <h2>CRUD table with inline editing</h2>
  </div>
  <p>Rows are added, edited, deleted, and counted through HTML fragments.</p>
</div>

<div class="crud-toolbar">
  <form class="inline-create" hx-post="/api/items" hx-target="#items-body" hx-swap="beforeend">
    <label class="field">
      <span>Item</span>
      <input name="name" placeholder="New htmx pattern" required>
    </label>
    <label class="field">
      <span>Owner</span>
      <input name="owner" placeholder="Owner" required>
    </label>
    <label class="field">
      <span>Status</span>
      <select name="status">
        <option>Draft</option>
        <option>Review</option>
        <option>Active</option>
      </select>
    </label>
    <button class="button button-primary" type="submit">Add row</button>
  </form>
  <div class="count-chip">
    <span id="item-count"><%= items.length %></span>
    <span>items</span>
  </div>
</div>

<div class="table-wrap">
  <table class="data-table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Owner</th>
        <th>Status</th>
        <th>Updated</th>
        <th class="table-actions">Actions</th>
      </tr>
    </thead>
    <tbody id="items-body">
      <% items.forEach((item) => { %>
        <%- include("item-row", { item }) %>
      <% }) %>
    </tbody>
  </table>
</div>

<details class="code-panel">
  <summary>REST verbs and out-of-band counter</summary>
  <pre><code>&lt;form hx-post="/api/items" hx-target="#items-body" hx-swap="beforeend"&gt;
&lt;button hx-delete="/api/items/1"
        hx-target="closest tr"
        hx-swap="outerHTML swap:500ms"
        hx-confirm="Delete this row?"&gt;
&lt;span id="item-count" hx-swap-oob="innerHTML"&gt;5&lt;/span&gt;</code></pre>
</details>
