<div class="section-heading">
  <div>
    <p class="eyebrow">Parameterized requests</p>
    <h2>Sortable and filterable table</h2>
  </div>
  <p>Headers and filters send normal query strings; the server returns the table region.</p>
</div>

<%- include("sortable-data-table", { table }) %>

<details class="code-panel">
  <summary>Sort and include parameters</summary>
  <pre><code>&lt;button hx-get="/api/data?sort=name&amp;order=asc"
        hx-target="#data-table"
        hx-swap="outerHTML"&gt;

&lt;select hx-get="/api/data"
        hx-trigger="change"
        hx-include="#data-filter"&gt;</code></pre>
</details>
