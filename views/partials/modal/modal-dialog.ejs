<div class="modal-backdrop">
  <section class="modal-dialog" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div>
      <p class="eyebrow">Workspace details</p>
      <h2 id="modal-title">Current workspace status</h2>
      <p>Review session context, activity state, and interface preferences in one place.</p>
    </div>
    <div class="modal-grid">
      <span>Session active</span>
      <span>Activity loaded</span>
      <span>Status healthy</span>
      <span>Theme synced</span>
    </div>
    <button class="button button-primary" type="button" hx-get="/api/modal/close" hx-target="#modal-container" hx-swap="innerHTML">Close</button>
  </section>
</div>
