<div class="app-shell">
  <div
    id="theme-style-listener"
    class="sr-only"
    hx-get="/api/preferences/theme-style"
    hx-trigger="themeChanged from:body"
    hx-target="#theme-vars"
    hx-swap="outerHTML"
    aria-hidden="true"
  ></div>

  <aside class="sidebar" aria-label="Showcase navigation">
    <a class="brand-lockup" href="#top" aria-label="htmx Unleashed home">
      <span class="brand-mark">hx</span>
      <span>
        <strong>htmx Unleashed</strong>
        <small>workspace</small>
      </span>
    </a>

    <nav class="side-nav" aria-label="Sections">
      <span class="side-nav-group">Live data</span>
      <a href="#widgets"><%- icon("grid", { size: 16 }) %><span>Lazy widgets</span></a>
      <a href="#feed"><%- icon("activity", { size: 16 }) %><span>Activity feed</span></a>
      <a href="#polling"><%- icon("refresh", { size: 16 }) %><span>Polling</span></a>

      <span class="side-nav-group">Forms &amp; data</span>
      <a href="#search"><%- icon("search", { size: 16 }) %><span>Live search</span></a>
      <a href="#crud"><%- icon("table", { size: 16 }) %><span>CRUD</span></a>
      <a href="#sorting"><%- icon("bars", { size: 16 }) %><span>Sort &amp; filter</span></a>

      <span class="side-nav-group">Patterns</span>
      <a href="#tabs"><%- icon("layers", { size: 16 }) %><span>Tabs</span></a>
      <a href="#modal"><%- icon("window", { size: 16 }) %><span>Modal</span></a>
      <a href="#toast"><%- icon("bell", { size: 16 }) %><span>Notifications</span></a>
      <a href="#advanced"><%- icon("zap", { size: 16 }) %><span>Advanced</span></a>
    </nav>

    <div class="sidebar-footer">
      <span class="mono-label">Signed in</span>
      <strong><%= currentUser.name %></strong>
      <span><%= currentUser.role %></span>
    </div>
  </aside>

  <main class="workspace" id="top">
    <section class="hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>

      <div class="hero-top">
        <span class="status-pill">
          <span class="status-dot"></span>
          Live demo
        </span>
        <div class="header-actions">
          <%- include("partials/dashboard/theme-toggle") %>
          <form hx-post="/auth/logout" hx-target="body" hx-swap="outerHTML transition:true">
            <button class="button button-ghost icon-leading" type="submit">
              <%- icon("logout", { size: 16 }) %>
              <span>Log out</span>
            </button>
          </form>
        </div>
      </div>

      <div class="hero-body">
        <h1>Welcome back, <span class="hero-name"><%= currentUser.name %></span>.</h1>
        <p class="lede">Server-driven UI in 14&nbsp;KB of htmx. Every interaction below is a normal HTTP request &mdash; the server responds with HTML and htmx swaps it in.</p>
      </div>

      <dl class="hero-meta">
        <div>
          <dt>Mode</dt>
          <dd>Live workspace</dd>
        </div>
        <div>
          <dt>Session</dt>
          <dd><%= currentUser.role %></dd>
        </div>
        <div>
          <dt>Data</dt>
          <dd>In-memory</dd>
        </div>
        <div>
          <dt>Theme</dt>
          <dd><%= theme === "light" ? "Light" : "Dark" %></dd>
        </div>
      </dl>
    </section>

    <section id="widgets" class="showcase-section">
      <%- include("partials/dashboard/widgets") %>
    </section>

    <section id="feed" class="showcase-section two-column">
      <%- include("partials/feed/infinite-scroll") %>
    </section>

    <section id="search" class="showcase-section">
      <%- include("partials/search/live-search") %>
    </section>

    <section id="crud" class="showcase-section">
      <%- include("partials/crud/crud-table") %>
    </section>

    <section id="tabs" class="showcase-section">
      <%- include("partials/dashboard/tabs") %>
    </section>

    <section id="polling" class="showcase-section">
      <%- include("partials/dashboard/polling") %>
    </section>

    <section id="modal" class="showcase-section">
      <%- include("partials/modal/modal") %>
    </section>

    <section id="toast" class="showcase-section">
      <%- include("partials/toast/toast") %>
    </section>

    <section id="sorting" class="showcase-section">
      <%- include("partials/data/sortable-table") %>
    </section>

    <section id="advanced" class="showcase-section">
      <%- include("partials/dashboard/advanced") %>
    </section>
  </main>

  <div id="modal-container" aria-live="polite"></div>
</div>
